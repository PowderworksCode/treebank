diff --git a/src/package_registry.rs b/src/package_registry.rs
new file mode 100644
index 0000000..2170c23
--- /dev/null
+++ b/src/package_registry.rs
@@ -0,0 +1,268 @@
+//! Where a published version comes from, and what shape it arrives in.
+//!
+//! A package registry is not an ecosystem. npm, pnpm, yarn and bun are four
+//! ecosystems with four manifests and four lockfiles, and they all resolve
+//! against one registry; Debian is a registry-shaped source with no ecosystem
+//! at all. Keeping them apart is the same separation this crate already makes
+//! between a language and the ecosystem that publishes it.
+//!
+//! Endpoints are data. Fetching is not: nothing here opens a socket, and the
+//! URL templates are strings a consumer substitutes into, exactly as
+//! `data/sources/linguist.toml` records the URL it was checked against.
+
+use std::collections::BTreeSet;
+use std::sync::LazyLock;
+
+use crate::registry;
+use crate::{EcosystemProfile, LanguageProfile, ecosystem_profiles, language_profiles};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum RegistryRole {
+    /// Publishes packages under coordinates it owns.
+    PackageRegistry,
+    /// Redistributes upstream releases, and ships every language there is.
+    Distribution,
+}
+
+/// The container a download arrives in, before compression.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ArchiveContainer {
+    Tar,
+    Zip,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ArchiveCompression {
+    Gzip,
+    Xz,
+    Bzip2,
+}
+
+/// Whether an archive holds source as written or the output of a build.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ArchiveContents {
+    Source,
+    BuildOutput,
+}
+
+/// What has to be known to open one archive.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct ArchiveShape {
+    pub id: &'static str,
+    pub display_name: &'static str,
+    pub container: ArchiveContainer,
+    /// Compressions this shape occurs in. More than one means a consumer has
+    /// to sniff rather than trust the file name.
+    pub compression: &'static [ArchiveCompression],
+    /// Tarballs wrap their entries in a single directory and zips do not.
+    /// Stripping a zip's first path segment would drop the whole `com/` of
+    /// `com/google/common/base/Ascii.java`.
+    pub strip_root: bool,
+    /// The payload is a second archive inside this one, under this name.
+    pub member: Option<&'static str>,
+    pub carries: ArchiveContents,
+}
+
+impl ArchiveShape {
+    pub fn is_source(&self) -> bool {
+        matches!(self.carries, ArchiveContents::Source)
+    }
+}
+
+/// How popular a package is, and who says so.
+///
+/// The metric matters more than the number. A downloads count, an installed-
+/// machines count and a count of public repositories that depend on something
+/// are three different questions, and a consumer that ranks by one while
+/// describing it as another is publishing a wrong claim rather than an
+/// imprecise one.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct PopularitySource {
+    pub source: &'static str,
+    pub publisher: &'static str,
+    /// Whether the registry itself publishes this number. A third-party index
+    /// can lag, change shape, or stop.
+    pub first_party: bool,
+    pub metric: PopularityMetric,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum PopularityMetric {
+    /// Traffic: how often it was fetched.
+    Downloads,
+    /// Machines that have it installed.
+    Installs,
+    /// Public repositories that depend on it — a dependency-graph proxy, not
+    /// traffic, and not comparable with a downloads number.
+    DependentRepos,
+}
+
+/// Whether source can be had from the registry at all.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum SourceAvailability {
+    /// A source archive is published under a coordinate of its own.
+    Published,
+    /// The package ships build output, and names the repository and commit it
+    /// was built from. Source has to come from the forge.
+    SourceLink,
+}
+
+#[derive(Debug, Clone, Copy)]
+pub struct PackageRegistry {
+    pub id: &'static str,
+    pub display_name: &'static str,
+    pub role: RegistryRole,
+    /// Languages this registry publishes. Empty for a distribution, which
+    /// ships all of them.
+    pub languages: &'static [&'static LanguageProfile],
+    /// Ecosystems that resolve against it.
+    pub ecosystems: &'static [&'static EcosystemProfile],
+    /// Coordinate shape, when a name alone does not address a package.
+    pub coordinate: Option<&'static str>,
+    pub metadata_url: Option<&'static str>,
+    pub metadata_accept: Option<&'static str>,
+    pub download_url: Option<&'static str>,
+    pub archives: &'static [&'static ArchiveShape],
+    pub source_availability: SourceAvailability,
+    pub popularity: Option<PopularitySource>,
+}
+
+impl PackageRegistry {
+    /// The archives worth fetching for a corpus: the ones that carry source.
+    pub fn source_archives(&self) -> impl Iterator<Item = &'static ArchiveShape> {
+        self.archives.iter().copied().filter(|a| a.is_source())
+    }
+
+    pub fn publishes_language(&self, language: &LanguageProfile) -> bool {
+        self.languages
+            .iter()
+            .any(|candidate| std::ptr::eq(*candidate, language))
+    }
+
+    pub fn serves_ecosystem(&self, ecosystem: &EcosystemProfile) -> bool {
+        self.ecosystems
+            .iter()
+            .any(|candidate| std::ptr::eq(*candidate, ecosystem))
+    }
+}
+
+#[derive(Debug, Clone, Copy)]
+pub struct ArchiveRegistration(pub &'static ArchiveShape);
+
+#[derive(Debug, Clone, Copy)]
+pub struct PackageRegistryRegistration(pub &'static PackageRegistry);
+
+registry::collect!(ArchiveRegistration);
+registry::collect!(PackageRegistryRegistration);
+
+static ARCHIVES: LazyLock<Vec<&'static ArchiveShape>> = LazyLock::new(|| {
+    let mut shapes = registry::iter::<ArchiveRegistration>
+        .into_iter()
+        .map(|registration| registration.0)
+        .collect::<Vec<_>>();
+    shapes.sort_by_key(|shape| shape.id);
+    for pair in shapes.windows(2) {
+        assert_ne!(pair[0].id, pair[1].id, "duplicate archive shape ID");
+    }
+    for shape in &shapes {
+        // A zip carries its own compression per entry; naming one outside it
+        // would be describing a container this crate does not model.
+        assert!(
+            !matches!(shape.container, ArchiveContainer::Zip) || shape.compression.is_empty(),
+            "archive shape {:?} is a zip and names a compression",
+            shape.id
+        );
+    }
+    shapes
+});
+
+static REGISTERED: LazyLock<Vec<&'static PackageRegistry>> = LazyLock::new(|| {
+    let mut registries = registry::iter::<PackageRegistryRegistration>
+        .into_iter()
+        .map(|registration| registration.0)
+        .collect::<Vec<_>>();
+    registries.sort_by_key(|registry| registry.id);
+    for pair in registries.windows(2) {
+        assert_ne!(pair[0].id, pair[1].id, "duplicate package registry ID");
+    }
+    let shapes = ARCHIVES.iter().collect::<Vec<_>>();
+    for entry in &registries {
+        for language in entry.languages {
+            assert!(
+                language_profiles()
+                    .iter()
+                    .any(|registered| std::ptr::eq(*registered, *language)),
+                "package registry {:?} publishes unregistered language {:?}",
+                entry.id,
+                language.id
+            );
+        }
+        for ecosystem in entry.ecosystems {
+            assert!(
+                ecosystem_profiles()
+                    .iter()
+                    .any(|registered| std::ptr::eq(*registered, *ecosystem)),
+                "package registry {:?} serves unregistered ecosystem {:?}",
+                entry.id,
+                ecosystem.id
+            );
+        }
+        let mut named = BTreeSet::new();
+        for archive in entry.archives {
+            assert!(
+                shapes
+                    .iter()
+                    .any(|registered| std::ptr::eq(**registered, *archive)),
+                "package registry {:?} names unregistered archive {:?}",
+                entry.id,
+                archive.id
+            );
+            assert!(
+                named.insert(archive.id),
+                "package registry {:?} repeats archive {:?}",
+                entry.id,
+                archive.id
+            );
+        }
+        // A registry that publishes source must say which archive carries it.
+        // The alternative is SourceLink, where the answer is "none of them".
+        assert!(
+            !matches!(entry.source_availability, SourceAvailability::Published)
+                || entry.archives.iter().any(|archive| archive.is_source()),
+            "package registry {:?} publishes source but names no source archive",
+            entry.id
+        );
+    }
+    registries
+});
+
+pub fn archive_shapes() -> &'static [&'static ArchiveShape] {
+    ARCHIVES.as_slice()
+}
+
+pub fn archive_shape(id: &str) -> Option<&'static ArchiveShape> {
+    archive_shapes()
+        .binary_search_by_key(&id, |shape| shape.id)
+        .ok()
+        .map(|index| archive_shapes()[index])
+}
+
+pub fn package_registries() -> &'static [&'static PackageRegistry] {
+    REGISTERED.as_slice()
+}
+
+pub fn package_registry(id: &str) -> Option<&'static PackageRegistry> {
+    package_registries()
+        .binary_search_by_key(&id, |entry| entry.id)
+        .ok()
+        .map(|index| package_registries()[index])
+}
+
+/// Every registry that publishes a language, in id order.
+pub fn package_registries_for_language(language: &str) -> Vec<&'static PackageRegistry> {
+    package_registries()
+        .iter()
+        .copied()
+        .filter(|entry| entry.languages.iter().any(|profile| profile.id == language))
+        .collect()
+}
