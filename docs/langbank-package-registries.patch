diff --git a/data/package-registries/debian.toml b/data/package-registries/debian.toml
new file mode 100644
index 0000000..6efacb9
--- /dev/null
+++ b/data/package-registries/debian.toml
@@ -0,0 +1,24 @@
+# A distribution rather than a registry: it publishes upstream's own release
+# tarball for software that has no registry of its own, which is what makes it
+# the only usable corpus source for C.
+id = "debian"
+display-name = "Debian"
+role = "distribution"
+# Deliberately no `languages`. A distribution ships every language there is,
+# and which ones a given source package contains is a measured fact, not a
+# static one — see `sloc-url`.
+metadata-url = "https://deb.debian.org/debian/dists/{suite}/main/source/Sources.gz"
+download-url = "https://deb.debian.org/debian/{directory}/{file}"
+archives = ["debian-orig-tarball"]
+# Per-package SLOC by language, which is how a consumer finds out whether a
+# source package is really the language it wants.
+sloc-url = "https://sources.debian.org/api/info/package/{name}/{version}/"
+
+# popcon counts machines that have the package installed, aggregated per source
+# package by Debian itself. Closer in kind to a downloads number than to a
+# dependency-graph proxy, but it is neither: it counts installations.
+[popularity]
+source = "https://popcon.debian.org/source/by_inst"
+publisher = "popcon.debian.org"
+first-party = true
+metric = "installs"
