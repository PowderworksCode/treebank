+/// Archive shapes, keyed by id in one table like facets and artifacts.
+fn archives(out: &mut String, path: &Path) {
+    let text = std::fs::read_to_string(path).expect("read archives.toml");
+    let shapes: BTreeMap<String, Value> = toml::from_str(&text).expect("parse archives.toml");
+    out.push_str("pub(crate) mod archive_shapes {\n");
+    for (id, shape) in &shapes {
+        let compression = shape
+            .get("compression")
+            .and_then(Value::as_array)
+            .map_or_else(Vec::new, |array| {
+                array
+                    .iter()
+                    .filter_map(Value::as_str)
+                    .map(|kind| format!("crate::ArchiveCompression::{}", camel(kind)))
+                    .collect()
+            });
+        let member = shape
+            .get("member")
+            .and_then(Value::as_str)
+            .map_or_else(|| "None".to_owned(), |member| format!("Some({member:?})"));
+        writeln!(
+            out,
+            "    pub static {name}: crate::ArchiveShape = crate::ArchiveShape {{\n\
+             \x20       id: {id:?},\n\
+             \x20       display_name: {display:?},\n\
+             \x20       container: crate::ArchiveContainer::{container},\n\
+             \x20       compression: &[{compression}],\n\
+             \x20       strip_root: {strip},\n\
+             \x20       member: {member},\n\
+             \x20       carries: crate::ArchiveContents::{carries},\n\
+             \x20   }};\n\
+             \x20   crate::registry::submit! {{ crate::ArchiveRegistration(&{name}) }}",
+            name = screaming(id),
+            display = shape
+                .get("display-name")
+                .and_then(Value::as_str)
+                .unwrap_or(id),
+            container = camel(
+                shape
+                    .get("container")
+                    .and_then(Value::as_str)
+                    .unwrap_or("tar")
+            ),
+            compression = compression.join(", "),
+            strip = shape
+                .get("strip-root")
+                .and_then(Value::as_bool)
+                .unwrap_or(false),
+            member = member,
+            carries = camel(
+                shape
+                    .get("carries")
+                    .and_then(Value::as_str)
+                    .unwrap_or("source")
+            ),
+        )
+        .expect("write archive shape");
+    }
+    out.push_str("}\n\n");
+}
+
+/// Where a published version comes from. One file per registry, pointing at
+/// the languages it publishes, the ecosystems that resolve against it and the
+/// archive shapes it serves.
+fn package_registries(out: &mut String, directory: &Path) {
+    let mut files = std::fs::read_dir(directory)
+        .expect("read data/package-registries")
+        .filter_map(Result::ok)
+        .map(|entry| entry.path())
+        .filter(|path| path.extension().is_some_and(|ext| ext == "toml"))
+        .collect::<Vec<_>>();
+    files.sort();
+
+    out.push_str("pub(crate) mod package_registries {\n");
+    let mut exports = Vec::new();
+    for path in &files {
+        println!("cargo:rerun-if-changed={}", path.display());
+        let text = std::fs::read_to_string(path).expect("read package registry toml");
+        let entry: Value =
+            toml::from_str(&text).unwrap_or_else(|error| panic!("{}: {error}", path.display()));
+        let id = entry
+            .get("id")
+            .and_then(Value::as_str)
+            .expect("package registry id");
+        exports.push(id.to_owned());
+
+        let languages = entry
+            .get("languages")
+            .and_then(Value::as_array)
+            .map_or_else(Vec::new, |array| {
+                array
+                    .iter()
+                    .filter_map(Value::as_str)
+                    .map(|language| {
+                        format!("&super::super::languages::{}::PROFILE", ident(language))
+                    })
+                    .collect()
+            });
+        let ecosystems = entry
+            .get("ecosystems")
+            .and_then(Value::as_array)
+            .map_or_else(Vec::new, |array| {
+                array
+                    .iter()
+                    .filter_map(Value::as_str)
+                    .map(|eco| format!("&super::super::ecosystems::{}::PROFILE", ident(eco)))
+                    .collect()
+            });
+        let archives =
+            entry
+                .get("archives")
+                .and_then(Value::as_array)
+                .map_or_else(Vec::new, |array| {
+                    array
+                        .iter()
+                        .filter_map(Value::as_str)
+                        .map(|archive| {
+                            format!("&super::super::archive_shapes::{}", screaming(archive))
+                        })
+                        .collect()
+                });
+        let optional = |key: &str| {
+            entry
+                .get(key)
+                .and_then(Value::as_str)
+                .map_or_else(|| "None".to_owned(), |value| format!("Some({value:?})"))
+        };
+        let popularity = entry.get("popularity").map_or_else(
+            || "None".to_owned(),
+            |popularity| {
+                format!(
+                    "Some(crate::PopularitySource {{ source: {:?}, publisher: {:?}, first_party: {}, metric: crate::PopularityMetric::{} }})",
+                    popularity.get("source").and_then(Value::as_str).unwrap_or_default(),
+                    popularity.get("publisher").and_then(Value::as_str).unwrap_or_default(),
+                    popularity.get("first-party").and_then(Value::as_bool).unwrap_or(false),
+                    camel(popularity.get("metric").and_then(Value::as_str).unwrap_or("downloads")),
+                )
+            },
+        );
+
+        writeln!(
+            out,
+            "    pub mod {module} {{\n\
+             \x20       pub static PROFILE: crate::PackageRegistry = crate::PackageRegistry {{\n\
+             \x20           id: {id:?},\n\
+             \x20           display_name: {display:?},\n\
+             \x20           role: crate::RegistryRole::{role},\n\
+             \x20           languages: &[{languages}],\n\
+             \x20           ecosystems: &[{ecosystems}],\n\
+             \x20           coordinate: {coordinate},\n\
+             \x20           metadata_url: {metadata},\n\
+             \x20           metadata_accept: {accept},\n\
+             \x20           download_url: {download},\n\
+             \x20           archives: &[{archives}],\n\
+             \x20           source_availability: crate::SourceAvailability::{availability},\n\
+             \x20           popularity: {popularity},\n\
+             \x20       }};\n\
+             \x20       crate::registry::submit! {{ crate::PackageRegistryRegistration(&PROFILE) }}\n\
+             \x20   }}",
+            module = ident(id),
+            display = entry
+                .get("display-name")
+                .and_then(Value::as_str)
+                .unwrap_or(id),
+            role = camel(
+                entry
+                    .get("role")
+                    .and_then(Value::as_str)
+                    .unwrap_or("package-registry")
+            ),
+            languages = languages.join(", "),
+            ecosystems = ecosystems.join(", "),
+            coordinate = optional("coordinate"),
+            metadata = optional("metadata-url"),
+            accept = optional("metadata-accept"),
+            download = optional("download-url"),
+            archives = archives.join(", "),
+            availability = camel(
+                entry
+                    .get("source-availability")
+                    .and_then(Value::as_str)
+                    .unwrap_or("published")
+            ),
+            popularity = popularity,
+        )
+        .expect("write package registry");
+    }
+    for id in &exports {
+        writeln!(
+            out,
+            "    pub use {}::PROFILE as {};",
+            ident(id),
+            screaming(id)
+        )
+        .expect("write package registry export");
+    }
+    out.push_str("}\n\n");
+}
