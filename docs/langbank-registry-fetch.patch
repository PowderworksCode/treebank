+//! The fetching half of a registry: endpoints, archive shapes, and what a
+//! popularity number measures.
+//!
+//! `registries_purl.rs` covers identity — what a package is called. This
+//! covers what a consumer needs to go and get one, which purl does not model
+//! and which was carried per-language in treebank's Rust until now.
+
+use langbank::*;
+
+#[test]
+fn every_purl_registry_survives_the_new_fields() {
+    // The 42 purl types keep working with nothing declared: no language, no
+    // archive, no popularity source. Only the six treebank fetches from say
+    // anything, and a registry that says nothing must not become invalid.
+    assert_eq!(package_registries().len(), 42, "purl types");
+    let described = package_registries()
+        .iter()
+        .filter(|entry| entry.popularity.is_some())
+        .count();
+    assert_eq!(described, 6, "registries with a popularity source");
+
+    let generic = package_registry("generic").expect("generic");
+    assert!(generic.languages.is_empty());
+    assert!(generic.archives.is_empty());
+    assert_eq!(generic.popularity, None);
+    assert_eq!(generic.source_availability, SourceAvailability::Published);
+}
+
+#[test]
+fn archives_keep_the_facts_an_unpacker_needs() {
+    assert_eq!(archive_shapes().len(), 10, "archive shapes");
+
+    // A tarball wraps its entries in one directory; a zip does not, and
+    // stripping one would drop the whole `com/` of a Java coordinate.
+    let crate_archive = archive_shape("crate").expect("crate");
+    assert_eq!(crate_archive.container, ArchiveContainer::Tar);
+    assert!(crate_archive.strip_root);
+
+    let sources_jar = archive_shape("sources-jar").expect("sources-jar");
+    assert_eq!(sources_jar.container, ArchiveContainer::Zip);
+    assert!(!sources_jar.strip_root);
+
+    // Debian ships whatever upstream released, so a consumer has to sniff.
+    let orig = archive_shape("debian-orig-tarball").expect("debian-orig-tarball");
+    assert_eq!(
+        orig.compression,
+        &[
+            ArchiveCompression::Gzip,
+            ArchiveCompression::Xz,
+            ArchiveCompression::Bzip2
+        ]
+    );
+
+    // The one nested shape: the source is a second tarball inside the first.
+    let gem = archive_shape("gem").expect("gem");
+    assert_eq!(gem.container, ArchiveContainer::Tar);
+    assert_eq!(gem.member, Some("data.tar.gz"));
+}
+
+#[test]
+fn source_and_build_output_are_distinguished() {
+    // Both are published under one Python coordinate and only one of them is
+    // the tree the author wrote.
+    assert!(archive_shape("sdist").expect("sdist").is_source());
+    assert!(!archive_shape("wheel").expect("wheel").is_source());
+    assert!(!archive_shape("nupkg").expect("nupkg").is_source());
+
+    let pypi = package_registry("pypi").expect("pypi");
+    let source: Vec<&str> = pypi.source_archives().map(|shape| shape.id).collect();
+    assert_eq!(source, vec!["sdist"]);
+
+    // NuGet publishes no source at all: a .nupkg is assemblies, and the
+    // repository and commit it was built from are in the .nuspec.
+    let nuget = package_registry("nuget").expect("nuget");
+    assert_eq!(nuget.source_availability, SourceAvailability::SourceLink);
+    assert_eq!(nuget.source_archives().count(), 0);
+}
+
+#[test]
+fn a_popularity_number_carries_what_it_measures() {
+    // Six registries, three different questions. A consumer that ranks by one
+    // while describing it as another publishes a wrong claim.
+    let expected = [
+        ("cargo", PopularityMetric::Downloads, true),
+        ("npm", PopularityMetric::Downloads, false),
+        ("pypi", PopularityMetric::Downloads, false),
+        ("maven", PopularityMetric::DependentRepos, false),
+        ("nuget", PopularityMetric::Downloads, true),
+        ("deb", PopularityMetric::Installs, true),
+    ];
+    for (id, metric, first_party) in expected {
+        let popularity = package_registry(id)
+            .expect("registry")
+            .popularity
+            .expect("popularity source");
+        assert_eq!(popularity.metric, metric, "{id} metric");
+        assert_eq!(popularity.first_party, first_party, "{id} first-party");
+        assert!(popularity.source.starts_with("https://"), "{id} source");
+    }
+}
+
+#[test]
+fn registries_point_at_languages_by_pointer() {
+    let cargo = package_registry("cargo").expect("cargo");
+    let rust = language_profile("rust").expect("rust");
+    assert!(cargo.publishes_language(rust));
+    assert!(!cargo.publishes_language(language_profile("python").expect("python")));
+
+    // One registry serves two languages: npm is where both JavaScript and
+    // TypeScript packages are published, whatever a package.json implies.
+    let npm = package_registry("npm").expect("npm registry");
+    assert!(npm.publishes_language(language_profile("javascript").expect("javascript")));
+    assert!(npm.publishes_language(language_profile("typescript").expect("typescript")));
+
+    // C# is `c-sharp` here, and a consumer spelling it otherwise gets nothing.
+    let registries = registries_for_language("c-sharp");
+    assert_eq!(registries.len(), 1);
+    assert_eq!(registries[0].id, "nuget");
+    assert!(registries_for_language("csharp").is_empty());
+}
+
+#[test]
+fn a_distribution_claims_no_language() {
+    // Debian ships every language there is; which one a source package holds
+    // is measured, not static, so the endpoint that measures it is not here.
+    let deb = package_registry("deb").expect("deb");
+    assert!(deb.languages.is_empty());
+    assert!(deb.metadata_url.is_some_and(|url| url.contains("{suite}")));
+}
+
+#[test]
+fn an_endpoint_is_not_a_path_under_the_canonical_host() {
+    // purl's default-repository is where a package is *named*. The host that
+    // serves the artifacts is routinely a different one, so an endpoint has to
+    // be carried whole rather than appended to a repository.
+    let maven = package_registry("maven").expect("maven");
+    assert_eq!(
+        maven.default_repository,
+        Some("https://repo.maven.apache.org/maven2/")
+    );
+    assert!(
+        maven
+            .download_url
+            .expect("download url")
+            .starts_with("https://repo1.maven.org/maven2/")
+    );
+
+    let nuget = package_registry("nuget").expect("nuget");
+    assert_eq!(nuget.default_repository, Some("https://www.nuget.org"));
+    assert!(
+        nuget
+            .download_url
+            .expect("download url")
+            .starts_with("https://api.nuget.org/v3-flatcontainer/")
+    );
+
+    // npm's is not derivable at all: the tarball URL is inside the metadata.
+    let npm = package_registry("npm").expect("npm");
+    assert_eq!(npm.download_url, None);
+    assert_eq!(
+        npm.metadata_accept,
+        Some("application/vnd.npm.install-v1+json")
+    );
+}
+
+#[test]
+fn a_manager_reaches_its_registrys_endpoints() {
+    // The join #7 made possible: an ecosystem points at a registry, and the
+    // registry now knows how to fetch. Four managers, one set of endpoints.
+    for id in ["npm", "pnpm", "yarn", "bun"] {
+        let ecosystem = ecosystem_profile(id).expect("ecosystem");
+        let registry = ecosystem.registry.expect("registry");
+        assert_eq!(registry.id, "npm");
+        assert_eq!(
+            registry.metadata_url,
+            Some("https://registry.npmjs.org/{name}")
+        );
+        assert_eq!(registry.source_archives().count(), 1);
+    }
+
+    let cargo = ecosystem_profile("cargo").expect("cargo");
+    let registry = cargo.registry.expect("registry");
+    assert!(registry.publishes_language(language_profile("rust").expect("rust")));
+}
