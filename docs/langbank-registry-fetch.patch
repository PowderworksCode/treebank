+    }
+    shapes
+});
+
+pub fn archive_shapes() -> &'static [&'static ArchiveShape] {
+    &ARCHIVES
+}
+
+pub fn archive_shape(id: &str) -> Option<&'static ArchiveShape> {
+    archive_shapes()
+        .iter()
+        .copied()
+        .find(|shape| shape.id == id)
+}
+
+/// Every registry that publishes a language, in id order.
+pub fn registries_for_language(language: &str) -> Vec<&'static PackageRegistry> {
+    package_registries()
+        .iter()
+        .copied()
+        .filter(|entry| entry.languages.iter().any(|profile| profile.id == language))
+        .collect()
 }
 
