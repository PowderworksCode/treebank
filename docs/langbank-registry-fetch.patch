index 0000000..652673b
--- /dev/null
+++ b/data/archives.toml
@@ -0,0 +1,86 @@
+# How a registry packages a published version, and what opening one requires.
+#
+# Distinct from `artifacts.toml`, which is what a *build produces* — a binary, a
+# site bundle, a Tauri app. This is what a *registry serves*: the container a
+# download arrives in. A consumer that unpacks one needs four facts, none of
+# which can be read off the file extension reliably enough to guess:
+#
+#   container    tar or zip, before compression
+#   strip-root   tarballs wrap their entries in one directory; zips do not, and
+#                stripping one would drop the whole `com/` of a Java coordinate
+#   member       the payload is a second archive inside the first (`.gem`)
+#   carries      source as written, or the output of a build
+#
+# `carries` is the one that decides whether a corpus consumer should want it at
+# all: a wheel and an sdist are both Python packages, and only one of them is
+# the tree the author wrote.
+
+[crate]
+display-name = "crates.io .crate"
+container = "tar"
+compression = ["gzip"]
+strip-root = true
+carries = "source"
+
+[npm-tarball]
+display-name = "npm tarball"
+container = "tar"
+compression = ["gzip"]
+strip-root = true
+carries = "source"
+
+[sdist]
+display-name = "Python source distribution"
+container = "tar"
+compression = ["gzip"]
+strip-root = true
+carries = "source"
+
+[wheel]
+display-name = "Python wheel"
+container = "zip"
+strip-root = false
+carries = "build-output"
+
+[sources-jar]
+display-name = "Maven -sources.jar"
+container = "zip"
+strip-root = false
+carries = "source"
+
+[jar]
+display-name = "Maven .jar"
+container = "zip"
+strip-root = false
+carries = "build-output"
+
+[nupkg]
+display-name = "NuGet package"
+container = "zip"
+strip-root = false
+carries = "build-output"
+
+# The one nested shape: the outer tar holds `data.tar.gz`, `metadata.gz` and
+# `checksums.yaml.gz` at its root, and the source is inside the first of them.
+[gem]
+display-name = "RubyGems .gem"
+container = "tar"
+strip-root = false
+member = "data.tar.gz"
+carries = "source"
+
+# Debian ships whatever upstream released, so all three compressions occur and
+# a consumer has to sniff rather than trust the name.
+[debian-orig-tarball]
+display-name = "Debian .orig.tar.*"
+container = "tar"
+compression = ["gzip", "xz", "bzip2"]
+strip-root = true
+carries = "source"
+
+[git-source-archive]
+display-name = "git forge source archive"
+container = "tar"
+compression = ["gzip"]
+strip-root = true
+carries = "source"
