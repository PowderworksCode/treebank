crates/treebank-sdf3/spike/*/targets/*/grammar.json          linguist-generated=true
crates/treebank-sdf3/spike/*/targets/*/grammar.js            linguist-generated=true
crates/treebank-sdf3/spike/*/targets/*/findings.md           linguist-generated=true
crates/treebank-sdf3/spike/*/targets/*/*.g4                  linguist-generated=true
