node_modules/
out/
.wrangler/
.DS_Store

# Derived from crates/ by tools/build-grammars.mjs, and from src/ by the
# build script. Committing them would mean a grammar could change without
# its reference page changing, which is the one thing this site must not do.
public/grammars/
public/*.mjs
public/grammar.css
content/grammars/*.md
!content/grammars/index.md

# Built artifacts, 14 MB. See site/README.md for how they are served.
public/packs/

# Hashed copies and the manifest are derived from the staged packs.
public/packs/index.json
