+a pointer to an if type expression
+================================================================================
+
+const builtin = @import("builtin");
+
+const Command = struct {
+    status: *if (builtin.link_libc) c_int else u32,
+    other: *const if (builtin.os.tag == .windows) u16 else u8,
+};
+
