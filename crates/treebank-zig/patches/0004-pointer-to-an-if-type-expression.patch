+    (struct_declaration
+      (container_field
+        name: (identifier)
+        type: (pointer_type
+          (if_type_expression
+            condition: (field_expression
+              object: (identifier)
+              member: (identifier))
+            (builtin_type)
+            (builtin_type))))
+      (container_field
+        name: (identifier)
+        type: (pointer_type
+          (if_type_expression
