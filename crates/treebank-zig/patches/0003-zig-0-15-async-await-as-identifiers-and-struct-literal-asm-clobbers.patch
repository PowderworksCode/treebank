@@ -0,0 +1,190 @@
+================================================================================
+async and await as field, member and initializer names
+================================================================================
+
+const S = struct {
+    await: u8,
+    async: *const fn (u8) void,
+};
+
+const E = enum { async, await, other };
+
+const async = 1;
+
+pub fn f() void {
+    const v = .{ .async = async, .await = 2 };
+    _ = v;
+}
+
+--------------------------------------------------------------------------------
+
+(source_file
+  (variable_declaration
+    (identifier)
+    (struct_declaration
+      (container_field
+        type: (builtin_type))
+      (container_field
+        type: (pointer_type
+          (function_signature
+            (parameters
+              (parameter
+                type: (builtin_type)))
+            type: (builtin_type))))))
+  (variable_declaration
+    (identifier)
+    (enum_declaration
+      (container_field)
+      (container_field)
+      (container_field
+        name: (identifier))))
+  (variable_declaration
+    (identifier)
+    (integer))
+  (function_declaration
+    name: (identifier)
+    (parameters)
+    type: (builtin_type)
+    body: (block
+      (variable_declaration
+        (identifier)
+        (anonymous_struct_initializer
+          (initializer_list
+            (field_initializer
+              (identifier))
+            (field_initializer
+              (integer)))))
+      (variable_declaration
+        (identifier)
+        (identifier)))))
+
+================================================================================
+async and await keep their pre-0.15 keyword meaning when an operand follows
+================================================================================
+
+fn g() void {}
+
+pub fn f() void {
+    var frame = async g();
+    await frame;
+}
+
+--------------------------------------------------------------------------------
+
+(source_file
+  (function_declaration
+    name: (identifier)
+    (parameters)
+    type: (builtin_type)
+    body: (block))
+  (function_declaration
+    name: (identifier)
+    (parameters)
+    type: (builtin_type)
+    body: (block
+      (variable_declaration
+        (identifier)
+        (async_expression
+          (call_expression
+            function: (identifier)
+            arguments: (arguments))))
+      (expression_statement
+        (await_expression
+          (identifier))))))
+
+================================================================================
+asm clobbers as a struct literal
+================================================================================
+
+pub fn f() void {
+    asm volatile ("" ::: .{ .memory = true });
+}
+
+--------------------------------------------------------------------------------
+
+(source_file
+  (function_declaration
+    name: (identifier)
+    (parameters)
+    type: (builtin_type)
+    body: (block
+      (expression_statement
+        (asm_expression
+          (string)
+          (asm_output
+            (asm_input
+              (asm_clobbers
+                (anonymous_struct_initializer
+                  (initializer_list
+                    (assignment_expression
+                      left: (field_expression
+                        member: (identifier))
+                      right: (boolean))))))))))))
+
+================================================================================
+asm clobbers as a string list, the pre-0.15 form
+================================================================================
+
+pub fn f() void {
+    asm volatile ("" ::: "memory");
+}
+
+--------------------------------------------------------------------------------
+
+(source_file
+  (function_declaration
+    name: (identifier)
+    (parameters)
+    type: (builtin_type)
+    body: (block
+      (expression_statement
+        (asm_expression
+          (string)
+          (asm_output
+            (asm_input
+              (asm_clobbers
+                (string
+                  (string_content))))))))))
+
+================================================================================
+asm clobbers with named outputs and inputs
+================================================================================
+
+pub fn f(x: u8) u8 {
+    return asm ("" : [r] "=r" (-> u8) : [a] "r" (x) : .{ .memory = true });
+}
+
+--------------------------------------------------------------------------------
+
+(source_file
+  (function_declaration
+    name: (identifier)
+    (parameters
+      (parameter
+        name: (identifier)
+        type: (builtin_type)))
+    type: (builtin_type)
+    body: (block
+      (expression_statement
+        (return_expression
+          (asm_expression
+            (string)
+            (asm_output
+              (asm_output_item
+                (identifier)
+                (string
+                  (string_content))
+                (builtin_type))
+              (asm_input
+                (asm_input_item
+                  (identifier)
+                  (string
+                    (string_content))
+                  (identifier))
+                (asm_clobbers
+                  (anonymous_struct_initializer
+                    (initializer_list
+                      (assignment_expression
+                        left: (field_expression
+                          member: (identifier))
+                        right: (boolean)))))))))))))
