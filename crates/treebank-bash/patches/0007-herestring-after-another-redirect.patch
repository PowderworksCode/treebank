diff --git a/grammar.js b/grammar.js
index c5c8773..0f94bed 100644
--- a/grammar.js
+++ b/grammar.js
@@ -183,10 +183,24 @@ module.exports = grammar({
       seq(
         field('body', $._statement),
         field('redirect', choice(
-          repeat1(choice(
-            $.file_redirect,
-            $.heredoc_redirect,
-          )),
+          seq(
+            repeat1(choice(
+              $.file_redirect,
+              $.heredoc_redirect,
+            )),
+            // A herestring may follow another redirect on the same command:
+            // `cat - 2>/dev/null <<< "$xml"` is ordinary bash, and without
+            // this the herestring has nowhere to attach once a file_redirect
+            // has pulled the command into a redirected_statement.
+            //
+            // It hangs off the end of that repeat1 rather than joining it,
+            // so a LONE herestring still takes the pre-existing path and
+            // `node <<< foo` keeps its old tree — an inline child of
+            // `command`, not a `redirected_statement` wrapper. Joining the
+            // repeat re-shapes every simple herestring in the corpus, which
+            // upstream's own Herestrings test catches.
+            optional($.herestring_redirect),
+          ),
         )),
       ),
       seq(
