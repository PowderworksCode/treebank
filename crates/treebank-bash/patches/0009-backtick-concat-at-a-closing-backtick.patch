+
+================================================================================
+Backtick command substitution whose body starts with whitespace
+================================================================================
+
+x=`date`
+y=` echo hi`
+z=a`echo b`
+
+--------------------------------------------------------------------------------
+
+(program
+  (variable_assignment
+    name: (variable_name)
+    value: (command_substitution
+      (command
+        name: (command_name
+          (word)))))
+  (variable_assignment
+    name: (variable_name)
+    value: (command_substitution
+      (command
+        name: (command_name
+          (word))
+        argument: (word))))
+  (variable_assignment
+    name: (variable_name)
+    value: (concatenation
+      (word)
+      (command_substitution
+        (command
+          name: (command_name
+            (word))
+          argument: (word))))))
