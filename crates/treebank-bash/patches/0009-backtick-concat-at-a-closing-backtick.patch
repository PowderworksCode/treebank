diff --git a/src/scanner.c b/src/scanner.c
index 0c3430a..0e29103 100644
--- a/src/scanner.c
+++ b/src/scanner.c
@@ -360,6 +360,10 @@ static bool scan(Scanner *scanner, TSLexer *lexer, const bool *valid_symbols) {
             if (lexer->lookahead == '`') {
                 lexer->mark_end(lexer);
                 advance(lexer);
+                if (lexer->lookahead == ';' || lexer->lookahead == '\n' || lexer->lookahead == '|' ||
+                    lexer->lookahead == '&' || lexer->lookahead == ')') {
+                    return false;
+                }
                 while (lexer->lookahead != '`' && !lexer->eof(lexer)) {
                     advance(lexer);
                 }
