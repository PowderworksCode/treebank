diff --git a/grammar.js b/grammar.js
index 7bd948b..47d882f 100644
--- a/grammar.js
+++ b/grammar.js
@@ -543,9 +543,13 @@ module.exports = grammar({
           repeat(choice(
             field('argument', $._literal),
             field('argument', alias($._bare_dollar, '$')),
-            field('argument', seq(
-              choice('=~', '=='),
-              choice($._literal, $.regex),
+            field('argument', choice(
+              // `==` in ARGUMENT position takes an ordinary word:
+              // `echo R == E`. Only `=~` takes a regex, whose scan runs to
+              // the enclosing `}` and would otherwise swallow the rest of a
+              // compound statement.
+              seq('==', $._literal),
+              seq('=~', choice($._literal, $.regex)),
             )),
             field('redirect', $.herestring_redirect),
           )),
