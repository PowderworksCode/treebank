+
+================================================================================
+Double equals as a command argument inside a compound
+================================================================================
+
+{
+  if true; then
+    echo R == E
+  fi
+}
+
+--------------------------------------------------------------------------------
+
+(program
+  (compound_statement
+    (if_statement
+      condition: (command
+        name: (command_name
+          (word)))
+      (command
+        name: (command_name
+          (word))
+        argument: (word)
+        argument: (word)))))
