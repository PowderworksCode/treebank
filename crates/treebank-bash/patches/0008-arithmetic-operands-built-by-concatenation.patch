@@ -772,7 +772,18 @@ module.exports = grammar({
       $.command_substitution,
     )),
 
+    // An arithmetic operand may be built by CONCATENATION, which nothing in
+    // these rules allowed: `$((0x$(cat file)))` glues a hex prefix to a
+    // command substitution, and `$((0x${v}))` to an expansion. bash expands
+    // the operand to text first and only then reads it as a number, so any
+    // adjacency is legal there.
+    _arithmetic_concatenation: $ => prec(2, seq(
+      choice($.number, $.variable_name, $._simple_variable_name),
+      repeat1(choice($.simple_expansion, $.expansion, $.command_substitution)),
+    )),
+
     _arithmetic_literal: $ => prec(1, choice(
+      alias($._arithmetic_concatenation, $.concatenation),
       $.number,
       $.subscript,
       $.simple_expansion,
