@@ -2046,3 +2046,38 @@ a=1 b=2 >/dev/null
       value: (number))
     redirect: (file_redirect
       destination: (word))))
+
+================================================================================
+Trailing compound command without a terminator
+================================================================================
+
+f() {(
+  echo hi
+)}
+if (test 1 -eq 0) then
+  echo no
+fi
+
+--------------------------------------------------------------------------------
+
+(program
+  (function_definition
+    name: (word)
+    body: (compound_statement
+      (subshell
+        (command
+          name: (command_name
+            (word))
+          argument: (word)))))
+  (if_statement
+    condition: (subshell
+      (command
+        name: (command_name
+          (word))
+        argument: (number)
+        argument: (word)
+        argument: (number)))
+    (command
+      name: (command_name
+        (word))
+      argument: (word))))
