diff --git a/grammar.js b/grammar.js
index 692d19b..9284663 100644
--- a/grammar.js
+++ b/grammar.js
@@ -129,10 +129,33 @@ module.exports = grammar({
       optional($._terminator),
     )),
 
-    _terminated_statement: $ => repeat1(seq(
-      $._statement,
-      $._terminator,
-    )),
+    _terminated_statement: $ => choice(
+      repeat1(seq(
+        $._statement,
+        $._terminator,
+      )),
+      // bash lets the LAST statement of a `{ }`, `do ... done`, `if ... fi`
+      // etc. drop its terminator when it is a bare compound command, because
+      // the compound's own closing token ends it: `f() {( echo hi )}` and
+      // `if (test $? -eq 0) then`. A redirected or piped compound does NOT
+      // get this — `f() { ( x ) >/dev/null }` is a syntax error in bash too.
+      seq(
+        repeat(seq($._statement, $._terminator)),
+        $._compound_command,
+      ),
+    ),
+
+    _compound_command: $ => choice(
+      $.subshell,
+      $.compound_statement,
+      $.if_statement,
+      $.while_statement,
+      $.for_statement,
+      $.c_style_for_statement,
+      $.case_statement,
+      $.test_command,
+      $.function_definition,
+    ),
 
     // Statements
 
