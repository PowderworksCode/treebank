diff --git a/src/scanner.c b/src/scanner.c
index f31082e..620cb79 100644
--- a/src/scanner.c
+++ b/src/scanner.c
@@ -206,7 +206,13 @@ static inline bool scan_bare_dollar(TSLexer *lexer) {
         advance(lexer);
         lexer->result_symbol = BARE_DOLLAR;
         lexer->mark_end(lexer);
-        return iswspace(lexer->lookahead) || lexer->eof(lexer) || lexer->lookahead == '\"';
+        // A `$` is literal whenever what follows it cannot begin an
+        // expansion — `sed -e s/.ct$//`, `$\|`, `$)`.
+        return iswspace(lexer->lookahead) || lexer->eof(lexer) || lexer->lookahead == '\"' ||
+               !(lexer->lookahead == '{' || lexer->lookahead == '(' || lexer->lookahead == '\'' ||
+                 lexer->lookahead == '_' || lexer->lookahead == '@' || lexer->lookahead == '*' ||
+                 lexer->lookahead == '#' || lexer->lookahead == '?' || lexer->lookahead == '-' ||
+                 lexer->lookahead == '!' || lexer->lookahead == '$' || iswalnum(lexer->lookahead));
     }
 
     return false;
