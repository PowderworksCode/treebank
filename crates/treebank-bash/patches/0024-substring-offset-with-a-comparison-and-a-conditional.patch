@@ -1112,6 +1112,7 @@ module.exports = grammar({
         $.parenthesized_expression,
         $.command_substitution,
         alias($._expansion_max_length_binary_expression, $.binary_expression),
+        alias($._expansion_max_length_ternary_expression, $.ternary_expression),
         /\n/,
       )),
       optional(seq(
@@ -1125,6 +1126,7 @@ module.exports = grammar({
           $.parenthesized_expression,
           $.command_substitution,
           alias($._expansion_max_length_binary_expression, $.binary_expression),
+          alias($._expansion_max_length_ternary_expression, $.ternary_expression),
           /\n/,
         )),
       )),
@@ -1135,9 +1137,21 @@ module.exports = grammar({
       $.number,
       $.expansion,
       alias($._expansion_max_length_binary_expression, $.binary_expression),
+      alias($._expansion_max_length_ternary_expression, $.ternary_expression),
     ),
+
+    // `${address: ${#address} < 8 ? 0 : -8}` — the offset is an arithmetic
+    // expression, so it can compare and it can be a conditional
+    _expansion_max_length_ternary_expression: $ => prec.right(seq(
+      field('condition', $._expansion_max_length_expression),
+      '?',
+      field('consequence', $._expansion_max_length_expression),
+      ':',
+      field('alternative', $._expansion_max_length_expression),
+    )),
     _expansion_max_length_binary_expression: $ => {
       const table = [
+        [choice('<', '>', '<=', '>=', '==', '!='), PREC.COMPARE],
         [choice('+', '-'), PREC.ADD],
         [choice('*', '/', '%'), PREC.MULTIPLY],
       ];
