+
+================================================================================
+Substring offset with a comparison and a conditional
+================================================================================
+
+address=${address: ${#address} < 8 ? 0 : -8}
+
+--------------------------------------------------------------------------------
+
+(program
+  (variable_assignment
+    name: (variable_name)
+    value: (expansion
+      (variable_name)
+      (ternary_expression
+        condition: (binary_expression
+          (expansion
+            (variable_name))
+          (number))
+        consequence: (number)
+        alternative: (number)))))
