@@ -103,3 +103,18 @@ comment
 ---
 
 (program (comment))
+
+===========
+embedded document ends only at a line starting with =end
+===========
+
+=begin
+subtree = parse_subtree(["=begin\\n", "<<< #{basename}\\n", "=end\\n"])
+  =end
+=endless
+=end
+puts 1
+
+---
+
+(program (comment) (call method: (identifier) arguments: (argument_list (integer))))
