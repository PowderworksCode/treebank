+    name: (identifier)
+    parameters: (method_parameters
+      (optional_parameter name: (identifier) value: (integer))))
+  (method
+    name: (identifier)
+    parameters: (method_parameters (identifier)))
+  (singleton_method
+    object: (self)
+    name: (identifier)))
