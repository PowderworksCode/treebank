diff --git a/grammar.js b/grammar.js
index e90d470..b5c8550 100644
--- a/grammar.js
+++ b/grammar.js
@@ -1088,6 +1088,17 @@ module.exports = grammar({
       '-', '*', '/', '%', '!', '!~', '**', '<<', '>>', '~', '+@', '-@', '~@', '[]', '[]=', '`',
     ),
 
+    // Ruby's `fname` admits every reserved word, so `def super` and
+    // `def self` define ordinary methods with those names — pry and the
+    // parser gem both do it. All the other keywords already reach this
+    // rule through `identifier`; `self` and `super` do not, because each
+    // has its own rule that the lexer prefers. Aliased to `identifier` so
+    // the tree says "a method called self", not "the self expression".
+    //
+    // prec(-1) keeps `def self.foo` a singleton_method: where both a
+    // singleton definition and a method literally named `self` are
+    // possible, the singleton reading wins, which is what every real
+    // `def self.` in the corpus means.
     _method_name: $ => choice(
       $.identifier,
       $._function_identifier,
@@ -1097,6 +1108,8 @@ module.exports = grammar({
       $.delimited_symbol,
       $.operator,
       $._nonlocal_variable,
+      prec(-1, alias($.self, $.identifier)),
+      prec(-1, alias($.super, $.identifier)),
     ),
 
     _nonlocal_variable: $ => choice(
