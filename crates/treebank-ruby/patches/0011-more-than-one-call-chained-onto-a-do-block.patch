diff --git a/grammar.js b/grammar.js
index 215c7a9..777f74d 100644
--- a/grammar.js
+++ b/grammar.js
@@ -810,7 +810,14 @@ module.exports = grammar({
     // the preference has to be named on the rule that should keep going —
     // `_body_expr`'s own precedence does not settle it.
     _chained_command_call: $ => prec.left(1, seq(
-      field('receiver', alias($.command_call_with_block, $.call)),
+      field('receiver', choice(
+        alias($.command_call_with_block, $.call),
+        // Left-recursive so the chain can be longer than one link:
+        // `should.raise Foo do ... end.message` parsed, but
+        // `... end.message.should.match(/x/)` did not, because the result of
+        // the first link was not itself usable as a receiver here.
+        alias($._chained_command_call, $.call),
+      )),
       field('operator', $._call_operator),
       field('method', choice($.identifier, $._function_identifier, $.operator, $.constant)),
     )),
