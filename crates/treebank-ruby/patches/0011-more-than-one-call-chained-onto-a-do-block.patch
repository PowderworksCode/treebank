+
+===========
+more than one call chained onto a do block
+===========
+
+should.raise Foo do
+  bar
+end.message.should.match(/x/)
+
+---
+
+(program
+  (call
+    receiver: (call
+      receiver: (call
+        receiver: (call
+          receiver: (identifier)
+          method: (identifier)
+          arguments: (argument_list (constant))
+          block: (do_block body: (body_statement (identifier))))
+        method: (identifier))
+      method: (identifier))
+    method: (identifier)
+    arguments: (argument_list (parenthesized_statements (regex (string_content))))))
