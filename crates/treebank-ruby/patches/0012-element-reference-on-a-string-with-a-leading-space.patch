diff --git a/grammar.js b/grammar.js
index 777f74d..e1e2c5c 100644
--- a/grammar.js
+++ b/grammar.js
@@ -755,8 +755,23 @@ module.exports = grammar({
     parenthesized_statements: $ => seq('(', optional($._statements), ')'),
 
     element_reference: $ => prec.left(1, seq(
-      field('object', $._primary),
-      alias($._element_reference_bracket, '['),
+      choice(
+        seq(
+          field('object', $._primary),
+          alias($._element_reference_bracket, '['),
+        ),
+        // The scanner emits `_element_reference_bracket` for a `[` with
+        // whitespace before it only when an expression cannot start there.
+        // After a string literal one still can — adjacent string literals
+        // concatenate, so STRING_START stays valid — and the scanner has no
+        // way to know a `[` is nonetheless the only reading, because a string
+        // is not a method and cannot take command arguments. fog writes
+        // `tests('Compute::VcloudDirector | media' ['attributes'])`.
+        seq(
+          field('object', choice($.string, $.chained_string)),
+          '[',
+        ),
+      ),
       optional($._argument_list_with_trailing_comma),
       ']',
       optional(field('block', choice($.block, $.do_block))),
diff --git a/test/corpus/expressions.txt b/test/corpus/expressions.txt
index 072f326..c28fa04 100644
--- a/test/corpus/expressions.txt
+++ b/test/corpus/expressions.txt
@@ -2975,3 +2975,26 @@ end.message.should.match(/x/)
       method: (identifier))
     method: (identifier)
     arguments: (argument_list (parenthesized_statements (regex (string_content))))))
+
+===========
+element reference on a string with a space before the bracket
+===========
+
+x = 'abc' ['b']
+y = 'a' 'b'
+puts ['a']
+
+---
+
+(program
+  (assignment
+    left: (identifier)
+    right: (element_reference
+      object: (string (string_content))
+      (string (string_content))))
+  (assignment
+    left: (identifier)
+    right: (chained_string (string (string_content)) (string (string_content))))
+  (call
+    method: (identifier)
+    arguments: (argument_list (array (string (string_content))))))
