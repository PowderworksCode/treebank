diff --git a/grammar.js b/grammar.js
index 2bbe35c..15438e6 100644
--- a/grammar.js
+++ b/grammar.js
@@ -947,8 +947,18 @@ module.exports = grammar({
         $.identifier,
         alias('type', $.identifier),
       ),
-      $.type_parameter,
+      // Applying a generic accepts slices — `x: int[:]`, `Bar[:, ::1]` —
+      // which the PEP 695 *declaration* sites (def f[T], class C[T]) must
+      // not. They keep $.type_parameter; this aliases back to the same node
+      // name so the tree shape consumers query is unchanged.
+      alias($._type_argument_list, $.type_parameter),
     )),
+    _type_argument_list: $ => seq(
+      '[',
+      commaSep1(choice($.type, $.slice)),
+      optional(','),
+      ']',
+    ),
     union_type: $ => prec.left(seq($.type, '|', $.type)),
     constrained_type: $ => prec.right(seq($.type, ':', $.type)),
     member_type: $ => seq($.type, '.', $.identifier),
diff --git a/test/corpus/expressions.txt b/test/corpus/expressions.txt
index 7257d3f..a25ce65 100644
--- a/test/corpus/expressions.txt
+++ b/test/corpus/expressions.txt
@@ -1228,3 +1228,36 @@ y: type[int] = int
             (type
               (identifier)))))
       (identifier))))
+
+==================================
+Slices in a generic type application
+==================================
+
+a: int32_t[:] = f()
+foo: Bar[:, :, :]
+def to_chars(s) -> char_type[:]: ...
+def compute(x: my_type[:, ::1]): ...
+
+---
+
+(module
+  (expression_statement
+    (assignment
+      left: (identifier)
+      type: (type (generic_type (identifier) (type_parameter (slice))))
+      right: (call function: (identifier) arguments: (argument_list))))
+  (expression_statement
+    (assignment
+      left: (identifier)
+      type: (type (generic_type (identifier) (type_parameter (slice) (slice) (slice))))))
+  (function_definition
+    name: (identifier)
+    parameters: (parameters (identifier))
+    return_type: (type (generic_type (identifier) (type_parameter (slice))))
+    body: (block (expression_statement (ellipsis))))
+  (function_definition
+    name: (identifier)
+    parameters: (parameters
+      (typed_parameter (identifier)
+        type: (type (generic_type (identifier) (type_parameter (slice) (slice (integer)))))))
+    body: (block (expression_statement (ellipsis)))))
