+
+==================================
+PEP 646 unpacking beyond a bare name
+==================================
+
+def foo(*args: *(int or str)): ...
+data[*(x := y)]
+u = tuple[*Ts]
+
+---
+
+(module
+  (function_definition
+    name: (identifier)
+    parameters: (parameters
+      (typed_parameter
+        (list_splat_pattern (identifier))
+        type: (type
+          (splat_type
+            (parenthesized_expression
+              (boolean_operator left: (identifier) right: (identifier)))))))
+    body: (block (expression_statement (ellipsis))))
+  (expression_statement
+    (subscript
+      value: (identifier)
+      subscript: (list_splat
+        (parenthesized_expression
+          (named_expression name: (identifier) value: (identifier))))))
+  (expression_statement
+    (assignment
+      left: (identifier)
+      right: (subscript
+        value: (identifier)
+        subscript: (list_splat (identifier))))))
