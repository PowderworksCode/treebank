@@ -1237,11 +1237,18 @@ module.exports = grammar({
       $.this,
     ),
 
+    // JLS 8.4.1 VariableArityParameter:
+    //   {VariableModifier} UnannType {Annotation} ... VariableDeclaratorId
+    // The annotations sit between the element type and the ellipsis, where
+    // they annotate the array type the ellipsis creates —
+    // `String @Nullable ... args`. They are not legal after it, so
+    // `String ... @Nullable args` must keep failing
+    // (test/negative/VarargsAnnotationAfterEllipsis.java).
     spread_parameter: $ => seq(
       optional($.modifiers),
       $._unannotated_type,
-      '...',
       repeat($._annotation),
+      '...',
       $.variable_declarator,
     ),
 
