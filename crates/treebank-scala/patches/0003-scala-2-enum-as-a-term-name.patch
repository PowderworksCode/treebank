+================================================================================
+Scala 2 `enum` as a term name
+================================================================================
+
+class EnumValueSerializer[E](val enum: E)
+
+def qualifyEnum(enum: Enum[_]): String =
+  enum.getClass.getCanonicalName + "." + enum.name()
