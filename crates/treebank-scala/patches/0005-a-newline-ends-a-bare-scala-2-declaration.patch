+  // A newline in the middle of a `def`, which Scala allows to continue onto
+  // the next line in three places: before another parameter list, before the
+  // result type, and before the body. A bare Scala 2 declaration -- `def
+  // f(t: T)` with no result type and no body -- ENDS at that same newline,
+  // and the parser cannot tell the two apart: what follows may be an
+  // arbitrary distance away, so both readings are live at once and whichever
+  // the grammar prefers makes the other unreachable. It preferred continuing,
+  // so `def f(t: T)` followed by any other member did not parse at all.
+  //
+  // The lexer can tell, because the answer is the very next character. Only
+  // `(`, `[`, `:`, `=` or `{` continues a def; anything else ends it. So the
+  // continuation gets its own token, emitted on that lookahead alone, and the
+  // ending newline stays an ordinary AUTOMATIC_SEMICOLON. The two can no
+  // longer be confused, which is why the grammar needs no conflict for this.
+  //
+  // valid_symbols is what keeps this narrow: DEF_CONTINUATION is only ever
+  // valid inside a def's signature or before its body, so no other newline in
+  // the language is affected by it.
+  if (valid_symbols[DEF_CONTINUATION] && newline_count > 0 &&
+      (lexer->lookahead == '(' || lexer->lookahead == '[' ||
+       lexer->lookahead == ':' || lexer->lookahead == '=' ||
+       lexer->lookahead == '{')) {
+    lexer->mark_end(lexer);
+    lexer->result_symbol = DEF_CONTINUATION;
+    return true;
+  }
+
   if (valid_symbols[AUTOMATIC_SEMICOLON] && newline_count > 0) {
     // AUTOMATIC_SEMICOLON should not be issued in the middle of expressions
     // Thus, we exit this branch when encountering comments, else/catch clauses, etc.
