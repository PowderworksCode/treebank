diff --git a/src/scanner.c b/src/scanner.c
index eecef9a..aa701cf 100644
--- a/src/scanner.c
+++ b/src/scanner.c
@@ -217,7 +217,12 @@ static bool scan_implicit_end_tag(Scanner *scanner, TSLexer *lexer) {
         parent &&
         (
             !tag_can_contain(parent, &next_tag) ||
-            ((parent->type == HTML || parent->type == HEAD || parent->type == BODY) && lexer->eof(lexer))
+            // End of document closes EVERY open element, not just html/head/
+            // body. This is the spec's "stop parsing" step, which pops the
+            // whole stack of open elements; restricting it to those three
+            // left `<div><p>x` and every page that simply stops with tags
+            // open as an ERROR.
+            lexer->eof(lexer)
         )
     ) {
         pop_tag(scanner);
