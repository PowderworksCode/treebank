+                // `</script` only ends script data when the NAME ends there
+                // — the spec's script-data-end-tag-name state leaves this
+                // state only on whitespace, `/` or `>`, and treats anything
+                // else as more script data. Without the check, the very
+                // common way of writing a script tag inside a JavaScript
+                // string,
+                //
+                //     var s = "</script" + "><b>x</b>";
+                //
+                // closed the element in the middle of a string literal and
+                // put the rest of the document in ERROR. wpt has a whole
+                // directory of these under document-write/.
+                advance(lexer);
+                if (lexer->lookahead == '>' || lexer->lookahead == '/' ||
+                    iswspace(lexer->lookahead) || lexer->lookahead == 0) {
+                    break;
+                }
+                delimiter_index = 0;
+                lexer->mark_end(lexer);
+                continue;
             }
             advance(lexer);
         } else {
