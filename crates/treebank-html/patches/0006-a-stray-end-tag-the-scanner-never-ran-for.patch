diff --git a/src/scanner.c b/src/scanner.c
index aa701cf..1dd4fb5 100644
--- a/src/scanner.c
+++ b/src/scanner.c
@@ -328,7 +328,18 @@ static bool scan(Scanner *scanner, TSLexer *lexer, const bool *valid_symbols) {
             break;
 
         default:
-            if ((valid_symbols[START_TAG_NAME] || valid_symbols[END_TAG_NAME]) && !valid_symbols[RAW_TEXT]) {
+            // ERRONEOUS_END_TAG_NAME belongs in this test alongside its two
+            // siblings. `erroneous_end_tag` exists precisely for a `</x>`
+            // that closes nothing, and at document level with an empty tag
+            // stack it is the ONLY end-tag symbol the parser will accept —
+            // END_TAG_NAME is not valid there because there is no open
+            // element to close. Leaving it out meant the scanner declined to
+            // run in exactly the situation the rule was written for, so
+            // `<p>x</p></head>` was an ERROR while the same stray tag
+            // mid-document parsed. scan_end_tag_name already decides which
+            // of the two symbols to emit by looking at the stack.
+            if ((valid_symbols[START_TAG_NAME] || valid_symbols[END_TAG_NAME] ||
+                 valid_symbols[ERRONEOUS_END_TAG_NAME]) && !valid_symbols[RAW_TEXT]) {
                 return valid_symbols[START_TAG_NAME] ? scan_start_tag_name(scanner, lexer)
                                                      : scan_end_tag_name(scanner, lexer);
             }
