diff --git a/grammar.js b/grammar.js
index 70d7d40..d02918d 100644
--- a/grammar.js
+++ b/grammar.js
@@ -152,8 +152,19 @@ module.exports = grammar({
     // the longest match: `&amp;` is five characters to this rule's one. The
     // tree shape follows what upstream already does around entities —
     // `a &amp; b` is text, entity, text, and now `a & b` is text, text, text.
+    // `>` in text is not even a parse error in HTML5 — only `<` and `&`
+    // begin anything, so a lone `>` is ordinary character data and every
+    // browser shows it. Dropping it from the exclusion set is the whole fix;
+    // it cannot swallow a tag's own `>` because the lexer is in a tag state
+    // there and `text` is not valid in it.
+    //
+    // Measured on the same 132,492-file corpus, with patch 0003 already
+    // applied: 1,183 more files parse. The bulk of them are pages that
+    // display code — `SELECT ... WHERE o.created_at > NOW()`, `(job) =>
+    // utils_1.createJob(...)` — inside <pre>, <code> or a plain paragraph,
+    // where an author had no reason to write &gt;.
     text: _ => choice(
-      /[^<>&\s]([^<>&]*[^<>&\s])?/,
+      /[^<&\s]([^<&]*[^<&\s])?/,
       '&',
     ),
   },
