+    //
+    // `"` and `'` stay excluded: they are the same parse error but the
+    // grammar has quoted_attribute_value alternatives that must win, and `<`
+    // and `>` stay excluded because `>` ends the tag.
+    attribute_value: _ => /[^<>"'\s]+/,
 
