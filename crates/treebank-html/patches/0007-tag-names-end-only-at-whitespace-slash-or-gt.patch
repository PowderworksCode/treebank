+// A tag name is ASCII-alpha to START — that is the spec's tag-open state,
+// and it is what keeps `<?xml ... ?>`, `<3` and `< div` from being tags —
+// and after that runs to the first whitespace, `/` or `>`, which are the
+// only three characters the tag-name state ends on. Everything else is part
+// of the name, including `=`, `.`, `Ø` and even `<`.
+//
+// The old set (alnum, `-`, `:`) is a reasonable guess at what a tag name
+// ought to look like and it is not what the parser does. Real pages rely on
+// the difference: `<spanclass=language-selector__label-text>` is a missing
+// space that HTML reads as an element named `spanclass=language-selector__
+// label-text`, `<dØdd>` is an element with a non-ASCII name, and the wpt
+// suite has a case asserting that `<x<>` creates an element named `x<`.
+static bool tag_name_start(int32_t c) {
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
+}
+
+static bool tag_name_rest(int32_t c) {
+    return c != 0 && c != '/' && c != '>' && !iswspace(c);
+}
+
 static String scan_tag_name(TSLexer *lexer) {
     String tag_name = array_new();
-    while (iswalnum(lexer->lookahead) || lexer->lookahead == '-' || lexer->lookahead == ':') {
+    if (!tag_name_start(lexer->lookahead)) {
+        return tag_name;
+    }
+    while (tag_name_rest(lexer->lookahead)) {
         array_push(&tag_name, towupper(lexer->lookahead));
         advance(lexer);
     }
