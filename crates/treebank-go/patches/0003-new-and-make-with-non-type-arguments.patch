+================================================================================
+Calls to 'make' and 'new' with non-type arguments
+================================================================================
+
+package main
+
+func main() {
+  // Go 1.26: new(expr) takes a value, not only a type
+  new("hello")
+  new(int32(1000))
+  new(*ptr)
+
+  // `new` and `make` are predeclared identifiers, not keywords, so a
+  // local declaration shadows them and the call takes ordinary arguments
+  var make func(int) *X
+  make(n - 1)
+
+  // the type-taking forms are unchanged
+  new(int)
+  make([]int, 3)
+}
