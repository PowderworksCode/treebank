+================================================================================
+annotations on a nested declaration
+================================================================================
+
+module M
+  %a{private}
+  interface _P
+    def ===: (untyped) -> bool
+  end
+end
+
+--------------------------------------------------------------------------------
+
+(program
+  (decl
+    body: (module_decl
+      name: (module_name (constant))
+      body: (members
+        annotations: (annotations (annotation (annotation_text)))
+        (interface_decl
+          name: (interface_name (interface))
+          body: (interface_members
+            (interface_member
+              body: (method_member
+                name: (method_name (operator))
+                (method_types (method_type body: (method_type_body
+                  (parameters (required_positionals (parameter (type (builtin_type)))))
+                  (type (builtin_type)))))))))))))
