             body: (method_type_body
               (parameters (required_positionals (parameter (type (class_type (class_name (constant)))) (var_name (identifier)))))
               (type (class_type (class_name (constant)))))))))))))
+
+================================================================================
+overload list ending in ...
+================================================================================
+
+class C
+  def copy_from: (untyped source) -> void
+               | ...
+end
+
+--------------------------------------------------------------------------------
+
+(program
+  (decl
+    body: (class_decl
+      name: (class_name (constant))
+      body: (members
+        (member body: (method_member
+          name: (method_name (identifier))
+          (method_types (method_type body: (method_type_body
+            (parameters (required_positionals (parameter (type (builtin_type)) (var_name (identifier)))))
+            (type (builtin_type)))))))))))
