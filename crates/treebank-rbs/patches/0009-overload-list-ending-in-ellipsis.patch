diff --git a/grammar.js b/grammar.js
index 2b2187a..be46444 100644
--- a/grammar.js
+++ b/grammar.js
@@ -442,7 +442,12 @@ module.exports = grammar({
       field("body", $.method_type_body)),
 
     method_types: $ => choice(
-      sep1($.method_type, "|"),
+      // `...` may TERMINATE an overload list as well as replace it: RBS uses
+      // it for "this method has further overloads not written here", which is
+      // how aws-sdk's hand-written customizations extend generated signatures
+      // and how bigdecimal documents its numeric coercions. Only the
+      // replacing form was accepted.
+      seq(sep1($.method_type, "|"), optional(seq("|", "..."))),
       "..."
     ),
 
