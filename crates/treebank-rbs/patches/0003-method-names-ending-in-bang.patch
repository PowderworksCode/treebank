+
+================================================================================
+method names ending in bang, the != operator, and alias
+================================================================================
+
+class Foo
+  def save!: () -> void
+  def self.use_bundled_cert!: () -> String
+  def !=: (untyped other) -> bool
+  alias filter! select!
+end
+--------------------------------------------------------------------------------
+
+(program
+  (decl
+    body: (class_decl
+      name: (class_name (constant))
+      body: (members
+        (member body: (method_member
+          name: (method_name (identifier_suffix (identifier)))
+          (method_types (method_type body: (method_type_body (parameters) (type (builtin_type)))))))
+        (member body: (method_member
+          name: (self)
+          name: (method_name (identifier_suffix (identifier)))
+          (method_types (method_type body: (method_type_body (parameters) (type (class_type (class_name (constant)))))))))
+        (member body: (method_member
+          name: (method_name (operator))
+          (method_types (method_type body: (method_type_body
+            (parameters (required_positionals (parameter (type (builtin_type)) (var_name (identifier)))))
+            (type (builtin_type)))))))
+        (member body: (alias_member
+          name: (method_name (identifier_suffix (identifier)))
+          origin_name: (method_name (identifier_suffix (identifier)))))))))
