diff --git a/grammar.js b/grammar.js
index 69c64cf..6af1c0b 100644
--- a/grammar.js
+++ b/grammar.js
@@ -440,7 +440,20 @@ module.exports = grammar({
       "..."
     ),
 
-    method_type_parameters: $ => seq("[", commaSep1($.type_variable), "]"),
+    // A method's type parameter may carry an upper bound, exactly as a
+    // module's may: `def pos=: [U < _ToInt] (U pos) -> U`. Only the module
+    // form had bounds, so every bounded generic method failed — 11 files,
+    // most of them rbs's own core signatures for Data, Dir and Encoding.
+    //
+    // Variance and `unchecked` are deliberately NOT accepted here: RBS allows
+    // them only on a module's parameters, and `RBS::Parser` rejects
+    // `def f: [out T] () -> T`. test/negative/ holds that rejection.
+    //
+    // Inlined rather than given its own node, so a parameter without a bound
+    // still parses to a bare `type_variable` and upstream's corpus tests keep
+    // passing unchanged.
+    method_type_parameters: $ =>
+      seq("[", commaSep1(seq($.type_variable, optional($.generics_bound))), "]"),
 
     attribute_member: $ => choice(
       seq(optional($.visibility), $.attribyte_type, field("name", $._attribute_name), ":", $.type),
diff --git a/test/corpus/methods.txt b/test/corpus/methods.txt
index 787331c..575a4a8 100644
