@@ -1046,3 +1046,28 @@ end
         (member body: (alias_member
           name: (method_name (identifier_suffix (identifier)))
           origin_name: (method_name (identifier_suffix (identifier)))))))))
+
+================================================================================
+bounded type parameters on a method type
+================================================================================
+
+class C
+  def pos=: [U < _ToInt] (U pos) -> U
+end
+
+--------------------------------------------------------------------------------
+
+(program
+  (decl
+    body: (class_decl
+      name: (class_name (constant))
+      body: (members
+        (member body: (method_member
+          name: (method_name (setter (identifier)))
+          (method_types (method_type
+            type_parameters: (method_type_parameters
+              (type_variable (constant))
+              (generics_bound (bound_type (interface_type (interface_name (interface))))))
+            body: (method_type_body
+              (parameters (required_positionals (parameter (type (class_type (class_name (constant)))) (var_name (identifier)))))
+              (type (class_type (class_name (constant)))))))))))))
