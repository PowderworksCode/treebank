-    _record_type_single: $ => seq(optional("?"), field("key", alias($.identifier, $.record_key)), ":", field("value", $.type)),
+    // A record key may be a quoted string or a symbol with `=>`, not only a
+    // bare identifier with `:`. roo declares its Excel format table as
+    // `{ 'h:mm am/pm' => :date }`, and activerecord mixes the two forms in
+    // one type: `{ from: untyped, :exclude_end => untyped }`.
+    _record_type_single: $ => choice(
+      seq(optional("?"), field("key", alias($.identifier, $.record_key)), ":", field("value", $.type)),
+      seq(optional("?"), field("key", alias($.string_literal, $.record_key)), "=>", field("value", $.type)),
+      seq(optional("?"), field("key", alias($.symbol_literal, $.record_key)), "=>", field("value", $.type)),
+    ),
     record_type: $ => seq("{", optional(seq(commaSep1($._record_type_single), optional(","))), "}"),
 
     class_name: $ => seq(optional($.namespace), $.constant),
