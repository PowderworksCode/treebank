{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "rubyish",
  "rules": {
    "program": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "nl"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_stmt"
          }
        }
      ]
    },
    "assign": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "target",
          "content": {
            "type": "SYMBOL",
            "name": "id"
          }
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "_exp"
          }
        },
        {
          "type": "SYMBOL",
          "name": "nl"
        }
      ]
    },
    "expr": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_exp"
        },
        {
          "type": "SYMBOL",
          "name": "nl"
        }
      ]
    },
    "_stmt": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "assign"
        },
        {
          "type": "SYMBOL",
          "name": "expr"
        }
      ]
    },
    "exp_int": {
      "type": "SYMBOL",
      "name": "int"
    },
    "exp_regex": {
      "type": "SYMBOL",
      "name": "regex"
    },
    "array": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_lbracket_spaced"
          },
          "named": false,
          "value": "["
        },
        {
          "type": "FIELD",
          "name": "elements",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_exp"
                  },
                  {
                    "type": "REPEAT",
                    "content": {
                      "type": "SEQ",
                      "members": [
                        {
                          "type": "STRING",
                          "value": ","
                        },
                        {
                          "type": "SYMBOL",
                          "name": "_exp"
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "type": "BLANK"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "exp_bracket": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_lparen_spaced"
          },
          "named": false,
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "_exp"
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "index": {
      "type": "PREC",
      "value": 5,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "receiver",
            "content": {
              "type": "SYMBOL",
              "name": "_exp"
            }
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_lbracket_adjacent"
            },
            "named": false,
            "value": "["
          },
          {
            "type": "FIELD",
            "name": "index",
            "content": {
              "type": "SYMBOL",
              "name": "_exp"
            }
          },
          {
            "type": "STRING",
            "value": "]"
          }
        ]
      }
    },
    "call": {
      "type": "PREC",
      "value": 5,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "method",
            "content": {
              "type": "SYMBOL",
              "name": "id"
            }
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_lparen_adjacent"
            },
            "named": false,
            "value": "("
          },
          {
            "type": "FIELD",
            "name": "arguments",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SEQ",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "_exp"
                    },
                    {
                      "type": "REPEAT",
                      "content": {
                        "type": "SEQ",
                        "members": [
                          {
                            "type": "STRING",
                            "value": ","
                          },
                          {
                            "type": "SYMBOL",
                            "name": "_exp"
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "type": "BLANK"
                }
              ]
            }
          },
          {
            "type": "STRING",
            "value": ")"
          }
        ]
      }
    },
    "command": {
      "type": "PREC_DYNAMIC",
      "value": 1,
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "FIELD",
              "name": "method",
              "content": {
                "type": "SYMBOL",
                "name": "id"
              }
            },
            {
              "type": "FIELD",
              "name": "argument",
              "content": {
                "type": "SYMBOL",
                "name": "_arg"
              }
            }
          ]
        }
      }
    },
    "neg": {
      "type": "PREC",
      "value": 4,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_minus_spaced_tight"
            },
            "named": false,
            "value": "-"
          },
          {
            "type": "FIELD",
            "name": "operand",
            "content": {
              "type": "SYMBOL",
              "name": "_exp"
            }
          }
        ]
      }
    },
    "mul": {
      "type": "PREC_LEFT",
      "value": 3,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "left",
            "content": {
              "type": "SYMBOL",
              "name": "_exp"
            }
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_star"
            },
            "named": false,
            "value": "*"
          },
          {
            "type": "FIELD",
            "name": "right",
            "content": {
              "type": "SYMBOL",
              "name": "_exp"
            }
          }
        ]
      }
    },
    "div": {
      "type": "PREC_LEFT",
      "value": 3,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "left",
            "content": {
              "type": "SYMBOL",
              "name": "_exp"
            }
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_slash"
            },
            "named": false,
            "value": "/"
          },
          {
            "type": "FIELD",
            "name": "right",
            "content": {
              "type": "SYMBOL",
              "name": "_exp"
            }
          }
        ]
      }
    },
    "add": {
      "type": "PREC_LEFT",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "left",
            "content": {
              "type": "SYMBOL",
              "name": "_exp"
            }
          },
          {
            "type": "STRING",
            "value": "+"
          },
          {
            "type": "FIELD",
            "name": "right",
            "content": {
              "type": "SYMBOL",
              "name": "_exp"
            }
          }
        ]
      }
    },
    "sub": {
      "type": "PREC_LEFT",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "left",
            "content": {
              "type": "SYMBOL",
              "name": "_exp"
            }
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_minus"
            },
            "named": false,
            "value": "-"
          },
          {
            "type": "FIELD",
            "name": "right",
            "content": {
              "type": "SYMBOL",
              "name": "_exp"
            }
          }
        ]
      }
    },
    "_exp": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "id"
        },
        {
          "type": "SYMBOL",
          "name": "exp_int"
        },
        {
          "type": "SYMBOL",
          "name": "exp_regex"
        },
        {
          "type": "SYMBOL",
          "name": "array"
        },
        {
          "type": "SYMBOL",
          "name": "exp_bracket"
        },
        {
          "type": "SYMBOL",
          "name": "index"
        },
        {
          "type": "SYMBOL",
          "name": "call"
        },
        {
          "type": "SYMBOL",
          "name": "command"
        },
        {
          "type": "SYMBOL",
          "name": "neg"
        },
        {
          "type": "SYMBOL",
          "name": "mul"
        },
        {
          "type": "SYMBOL",
          "name": "div"
        },
        {
          "type": "SYMBOL",
          "name": "add"
        },
        {
          "type": "SYMBOL",
          "name": "sub"
        }
      ]
    },
    "splat": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_star_spaced_tight"
          },
          "named": false,
          "value": "*"
        },
        {
          "type": "FIELD",
          "name": "operand",
          "content": {
            "type": "SYMBOL",
            "name": "_exp"
          }
        }
      ]
    },
    "_arg": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_exp"
        },
        {
          "type": "SYMBOL",
          "name": "splat"
        }
      ]
    },
    "id": {
      "type": "PATTERN",
      "value": "[a-z_](?:[a-zA-Z0-9_])*"
    },
    "int": {
      "type": "PATTERN",
      "value": "(?:[0-9])+"
    },
    "comment": {
      "type": "PATTERN",
      "value": "#(?:[^\\n])*"
    },
    "nl": {
      "type": "PATTERN",
      "value": "[\\n](?:(?:[ \\t\\n]|#(?:[^\\n])*))*"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t]"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "regex"
    },
    {
      "type": "SYMBOL",
      "name": "_minus_spaced_tight"
    },
    {
      "type": "SYMBOL",
      "name": "_star_spaced_tight"
    },
    {
      "type": "SYMBOL",
      "name": "_lbracket_adjacent"
    },
    {
      "type": "SYMBOL",
      "name": "_lbracket_spaced"
    },
    {
      "type": "SYMBOL",
      "name": "_lparen_adjacent"
    },
    {
      "type": "SYMBOL",
      "name": "_lparen_spaced"
    },
    {
      "type": "SYMBOL",
      "name": "_minus"
    },
    {
      "type": "SYMBOL",
      "name": "_slash"
    },
    {
      "type": "SYMBOL",
      "name": "_star"
    },
    {
      "type": "SYMBOL",
      "name": "_error_sentinel"
    }
  ],
  "inline": [],
  "supertypes": [
    "_stmt",
    "_exp",
    "_arg"
  ]
}
