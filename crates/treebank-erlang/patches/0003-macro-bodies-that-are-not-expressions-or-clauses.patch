               (expr_args))))))))
+
+================================================================================
+Macro bodies that are not expressions or complete clauses
+================================================================================
+
+-define(WITH_STACKTRACE(T, R, S), T:R:S ->).
+-define(BIND_STACKTRACE(Var), :Var).
+-define(OPT, #decode_opt_v2).
+-define(CATCH(T, R, S), T:R -> S = erlang:get_stacktrace(), ).
+
+--------------------------------------------------------------------------------
+(source_file
+  (pp_define
+    (macro_lhs (var) (var_args (var) (var) (var)))
+    (replacement_clause_head
+      (remote (remote_module (var)) (remote (remote_module (var)) (var)))))
+  (pp_define
+    (macro_lhs (var) (var_args (var)))
+    (replacement_leading_colon (var)))
+  (pp_define
+    (macro_lhs (var))
+    (record_name (atom)))
+  (pp_define
+    (macro_lhs (var) (var_args (var) (var) (var)))
+    (replacement_partial_clauses
+      (remote (remote_module (var)) (var))
+      (match_expr (var) (remote (remote_module (atom)) (call (atom) (expr_args)))))))
