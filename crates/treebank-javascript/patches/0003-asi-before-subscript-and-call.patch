+=====================================================
+Semicolons before `[` and `(` where nothing can continue
+=====================================================
+
+let a
+[a] = [1]
+
+var b
+(b)
+
+function f() {
+  return
+  [1]
+}
+
+class C {
+  x
+  [y] = 1
+}
