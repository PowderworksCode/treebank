diff --git a/common/scanner.h b/common/scanner.h
index 23b78b5..312578a 100644
--- a/common/scanner.h
+++ b/common/scanner.h
@@ -98,6 +98,21 @@ static bool scan_automatic_semicolon(TSLexer *lexer, const bool *valid_symbols,
             if (lexer->lookahead == ':') {
                 return valid_symbols[LOGICAL_OR]; // Don't return false if we're in a ternary by checking if || is valid
             }
+            // Same problem one token further out, for an *optional*
+            // destructured parameter:
+            //   type F = ({a}?: {a: number}) => number;
+            //   type G = ({a}?) => number;
+            // A '?' that is itself followed by ':' or ')' closes a parameter,
+            // not a ternary, so the semicolon must not be inserted.
+            if (lexer->lookahead == '?') {
+                do {
+                    skip(lexer);
+                } while (iswspace(lexer->lookahead));
+                if (lexer->lookahead == ':' || lexer->lookahead == ')') {
+                    return valid_symbols[LOGICAL_OR];
+                }
+                return true;
+            }
             return true;
         }
         if (!iswspace(lexer->lookahead)) {
