diff --git a/common/scanner.h b/common/scanner.h
index 312578a..9e7d40a 100644
--- a/common/scanner.h
+++ b/common/scanner.h
@@ -138,7 +138,6 @@ static bool scan_automatic_semicolon(TSLexer *lexer, const bool *valid_symbols,
         case '*':
         case '%':
         case '>':
-        case '<':
         case '=':
         case '?':
         case '^':
@@ -154,6 +153,18 @@ static bool scan_automatic_semicolon(TSLexer *lexer, const bool *valid_symbols,
             }
             break;
 
+            // In an expression a leading '<' continues the previous line
+            // (comparison, or a type argument list). In a type it can only
+            // start the next member of an object type -- an overload's call
+            // signature, `<E>(g: string): number` -- so the semicolon that
+            // separates the members has to be inserted. Same expression/type
+            // test as '(' and '[' below.
+        case '<':
+            if (valid_symbols[LOGICAL_OR]) {
+                return false;
+            }
+            break;
+
             // Don't insert a semicolon before a '[' or '(', unless we're parsing
             // a type. Detect whether we're parsing a type or an expression using
             // the validity of a binary operator token.
