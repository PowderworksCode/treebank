+=================================
+Cast require_once, match and yield
+=================================
+
+<?php
+$a = (bool) require_once 'some.php';
+$b = (string) match (true) {
+    default => 'x',
+};
+function g() {
+    $c = (int) yield 1;
+}
+
+---
+
+(program
+  (php_tag)
+  (expression_statement
+    (assignment_expression
+      left: (variable_name (name))
+      right: (cast_expression
+        type: (cast_type)
+        value: (require_once_expression (string (string_content)))
+      )
+    )
+  )
+  (expression_statement
+    (assignment_expression
+      left: (variable_name (name))
+      right: (cast_expression
+        type: (cast_type)
+        value: (match_expression
+          condition: (parenthesized_expression (boolean))
+          body: (match_block
+            (match_default_expression
+              return_expression: (string (string_content))))
+        )
+      )
+    )
+  )
+  (function_definition
+    name: (name)
+    parameters: (formal_parameters)
+    body: (compound_statement
+      (expression_statement
+        (assignment_expression
+          left: (variable_name (name))
+          right: (cast_expression
+            type: (cast_type)
+            value: (yield_expression (array_element_initializer (integer)))
+          )
+        )
+      )
+    )
+  )
+)
+
