-        if (valid_symbols[S_DIR_YML_BGN] && is_s) {
+        // scn_dir_bgn decides between the three directive-start symbols by
+        // reading the name, so the gate has to admit any of them: %YAML is not
+        // always valid where %TAG and reserved directives still are (a document
+        // may carry at most one %YAML), and gating on S_DIR_YML_BGN alone left
+        // the scanner blind to '%' entirely once one had been seen.
+        if ((valid_symbols[S_DIR_YML_BGN] || valid_symbols[S_DIR_TAG_BGN] || valid_symbols[S_DIR_RSV_BGN]) && is_s) {
