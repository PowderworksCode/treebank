diff --git a/src/scanner.c b/src/scanner.c
index da872d1..f8aeb78 100644
--- a/src/scanner.c
+++ b/src/scanner.c
@@ -721,6 +721,10 @@ static bool scn_blk_str_bgn(Scanner *scanner, TSLexer *lexer, TSSymbol result_sy
         ind += cur_ind;
     } else {
         ind = cur_ind;
+        // Highest indentation seen on a LEADING EMPTY line, in the same
+        // (column - 1) convention as `ind`. -2 means none seen yet, which is
+        // below every real column and so never trips the 8.1.1.1 check below.
+        int16_t max_bl_ind = -2;
         while (is_wsp(lexer->lookahead)) {
             adv(scanner, lexer);
         }
@@ -740,6 +744,9 @@ static bool scn_blk_str_bgn(Scanner *scanner, TSLexer *lexer, TSSymbol result_sy
                 if (scanner->cur_col - 1 < ind) {
                     break;
                 }
+                if (scanner->cur_col - 1 > max_bl_ind) {
+                    max_bl_ind = scanner->cur_col - 1;
+                }
                 ind = scanner->cur_col - 1;
                 adv_nwl(scanner, lexer);
             } else {
@@ -753,6 +760,16 @@ static bool scn_blk_str_bgn(Scanner *scanner, TSLexer *lexer, TSSymbol result_sy
                 if (lexer->lookahead == '\t' && scanner->cur_col - 1 < cur_ind) {
                     return false;
                 }
+                // YAML 1.2.2 8.1.1.1: it is an error for any of the leading
+                // empty lines to contain MORE spaces than the first non-empty
+                // line, because the auto-detected indentation would then come
+                // from whitespace rather than from content. Only checked once a
+                // leading empty line has been seen: a block scalar with no
+                // empty lines, and one that reaches EOF before any content, are
+                // both fine and must keep scanning.
+                if (max_bl_ind > scanner->cur_col - 1) {
+                    return false;
+                }
                 if (scanner->cur_col - 1 > ind) {
                     ind = scanner->cur_col - 1;
                 }
