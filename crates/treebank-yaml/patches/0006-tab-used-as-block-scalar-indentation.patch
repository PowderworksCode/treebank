diff --git a/src/scanner.c b/src/scanner.c
index 38911cd..da872d1 100644
--- a/src/scanner.c
+++ b/src/scanner.c
@@ -743,6 +743,16 @@ static bool scn_blk_str_bgn(Scanner *scanner, TSLexer *lexer, TSSymbol result_sy
                 ind = scanner->cur_col - 1;
                 adv_nwl(scanner, lexer);
             } else {
+                // YAML 1.2.2 6.1: indentation is spaces only. If the line the
+                // auto-detected content indentation would be taken from begins
+                // with a TAB that is still inside the PARENT's indentation, the
+                // tab is being used AS indentation, which is an error and not
+                // content. The bound is strict: one space then a tab (`|` then
+                // " \tbar") puts the tab past the parent, where it is ordinary
+                // content and must still scan.
+                if (lexer->lookahead == '\t' && scanner->cur_col - 1 < cur_ind) {
+                    return false;
+                }
                 if (scanner->cur_col - 1 > ind) {
                     ind = scanner->cur_col - 1;
                 }
