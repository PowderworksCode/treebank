@@ -2929,7 +2929,14 @@ static void newline_lookahead(Env *env, Newline *newline) {
         break;
       case '\t':
         skip_over(env, 0);
-        newline->indent += 8;
+        // One column, not eight. The report's tab stops are every eighth column, but the only
+        // other measure of a column in this scanner is `column()`, i.e. tree-sitter's
+        // `get_column`, which counts a tab as one like any other character. Counting eight here
+        // and one there makes the two incomparable, and layout is nothing but comparing them:
+        // a `let` on a tab-indented line inside a `do` opened a context whose recorded indent
+        // no interior column could ever match. Consistency is what layout needs; the residual
+        // divergence from the report is described in LOCAL-PATCHES.md.
+        newline->indent += 1;
         break;
       default:
         if (is_space_char(peek0(env))) {
