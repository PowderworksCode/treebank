diff --git a/test/negative/safe-in-plain-extern.rs b/test/negative/safe-in-plain-extern.rs
new file mode 100644
index 0000000..9042413
--- /dev/null
+++ b/test/negative/safe-in-plain-extern.rs
@@ -0,0 +1,5 @@
+// RFC 3484 `safe` qualifiers are only legal inside `unsafe extern` blocks;
+// rustc hard-rejects them in a plain extern block on every edition.
+extern "C" {
+    safe fn get_random_u64() -> u64;
+}
