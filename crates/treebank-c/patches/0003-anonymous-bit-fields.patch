+    // C11 6.7.2.1: a struct-declarator is `declarator` or
+    // `declarator_opt : constant-expression`, so a bit-field may be
+    // anonymous — `unsigned int :3;` is padding with no name.
+    _field_declaration_declarator: $ => commaSep1(choice(
+      seq(
+        field('declarator', $._field_declarator),
+        optional($.bitfield_clause),
+      ),
+      $.bitfield_clause,
     )),
 
     bitfield_clause: $ => seq(':', $.expression),
