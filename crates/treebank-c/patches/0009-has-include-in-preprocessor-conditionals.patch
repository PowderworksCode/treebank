       alias($.preproc_unary_expression, $.unary_expression),
       alias($.preproc_binary_expression, $.binary_expression),
       alias($.preproc_parenthesized_expression, $.parenthesized_expression),
@@ -199,6 +200,16 @@ module.exports = grammar({
       seq('defined', $.identifier),
     ),
 
+    // `#if __has_include(<stdcountof.h>)` — C23, and a GNU extension long
+    // before that. Its operand is a header name, not an expression, so like
+    // `defined` it cannot go through preproc_call_expression.
+    preproc_has_include: $ => prec(PREC.CALL, seq(
+      choice('__has_include', '__has_include_next'),
+      '(',
+      choice($.string_literal, $.system_lib_string),
+      ')',
+    )),
+
     preproc_unary_expression: $ => prec.left(PREC.UNARY, seq(
       field('operator', choice('!', '~', '-', '+')),
       field('argument', $._preproc_expression),
diff --git a/test/corpus/preprocessor.txt b/test/corpus/preprocessor.txt
index 543b7f9..f9adb3f 100644
--- a/test/corpus/preprocessor.txt
+++ b/test/corpus/preprocessor.txt
@@ -469,3 +469,31 @@ Named Variadic Macro Parameters
       (identifier)
       (identifier))
     value: (preproc_arg)))
+
+================================================================================
+__has_include
+================================================================================
+
+#if __has_include(<stdcountof.h>)
+#define A 1
+#endif
+#if __has_include("local.h")
+#define B 2
+#endif
+
+--------------------------------------------------------------------------------
+
+(translation_unit
+  (preproc_if
+    condition: (preproc_has_include
+      (system_lib_string))
+    (preproc_def
+      name: (identifier)
+      value: (preproc_arg)))
+  (preproc_if
+    condition: (preproc_has_include
+      (string_literal
+        (string_content)))
+    (preproc_def
+      name: (identifier)
+      value: (preproc_arg))))
