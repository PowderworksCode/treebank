@@ -607,9 +607,20 @@ module.exports = grammar({
     compound_statement: $ => seq(
       '{',
       repeat($._block_item),
+      // C23 6.8.1: a label may end a compound statement, with no statement
+      // after it — `out:` on the line before the closing brace. GCC and
+      // clang accept it in every dialect, and the kernel-style `goto out;`
+      // idiom leans on it. Restricted to this position so a label with no
+      // statement stays an error anywhere else.
+      optional(alias($.trailing_label, $.labeled_statement)),
       '}',
     ),
 
+    trailing_label: $ => seq(
+      field('label', $._statement_identifier),
+      ':',
+    ),
+
     storage_class_specifier: _ => choice(
       'extern',
       'static',
