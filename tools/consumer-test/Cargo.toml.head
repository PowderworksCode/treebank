# Generated by scripts/test-publish.sh: this head, plus one dependency line per
# grammar under test, taken from grammars.json. Generated rather than committed
# because both the version and the set of grammars are only known at test time —
# a change to one grammar tests that grammar alone.
#
# The dependency lines are the point of the test: each crate is pulled in under
# *upstream's* name via cargo's `package = ` rename, which is exactly how a
# consumer migrates to a patched redistribution without touching their code.
[package]
name = "treebank-consumer-test"
version = "0.0.0"
edition = "2021"
publish = false

[workspace]

[dependencies]
tree-sitter = "0.25"
