/target
/corpus/
db-dump.tar.gz
*.dylib
node_modules/


# wasm packs (built by CI, uploaded per run)
/dist/
__pycache__/

# `vale sync` downloads the style packages named in .vale.ini to here. That
# file's own comment is the rule: the styles are versioned by .vale.ini and
# fetched at run time, not committed.
/.vale/
crates/treebank-sdf3/spike/*/antlr-gen/

# The SDF3 family spikes generate one parser per target; the sources are
# regenerated by each spike's verify.sh and are not committed.
crates/treebank-sdf3/spike/*/targets/*/src/
